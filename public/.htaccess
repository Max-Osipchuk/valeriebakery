# SPA-маршрутизация для Apache: существующие файлы и папки отдаются как есть,
# все остальные пути (например, /privacy) получают index.html, дальше разбирается React Router.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
